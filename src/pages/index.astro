---
import { Image } from 'astro:assets';
import {
  ArrowRight,
  Building2,
  CircleCheck,
  CircleDollarSign,
  Scale,
  ShieldCheck,
} from '@lucide/astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import bg1 from '../assets/images/bg1.jpg';
import emblem from '../assets/images/varsity-emblem.png';
import stockImg from '../assets/images/stock.jpg';
import stockImg2 from '../assets/images/stock2.jpg';
import stockImg3 from '../assets/images/stock3.jpg';
import stockImg4 from '../assets/images/stock4.jpg';
import stockImg5 from '../assets/images/stock5.jpg';
import stockImg6 from '../assets/images/stock6.jpg';

const heroVideo = 'https://video.wixstatic.com/video/11062b_d21ff9e8cce1426fbd4f218f64fe884d/1080p/mp4/file.mp4';

const pillars = [
  {
    title: 'Fiduciary Structure',
    copy: 'An unwavering commitment to act solely in your best interest, backed by legal stewardship and total transparency in every directive.',
    icon: Scale,
  },
  {
    title: 'Fee-Only Management',
    copy: 'Free from product-based incentives, our independent, fee-only structure supports objective advice aligned with long-term and generational planning.',
    icon: CircleDollarSign,
  },
  {
    title: 'Family Approach',
    copy: 'We act as a trusted partner to your family, delivering an institutional-grade, architected approach to coordinating wealth across generations.',
    icon: Building2,
  },
];

const traditional = [
  'Conflicted, transactional fee structures.',
  'Misaligned legacy incentives and product-prioritization.',
  'Fragmented advice between siloed advisor networks.',
  'Institutional focus on short-term market performance.',
];

const varsity = [
  'Transparent, independent, fee-only fiduciary alignment.',
  'Conflict-free strategic orchestration across all assets.',
  'Integrated multi-disciplinary generational stewardship.',
  'Bespoke family office advisory with total capital clarity.',
];

const audiences = [
  {
    title: 'Families & Entrepreneurs Building Multi-Generational Wealth',
    copy: 'Tailored financial strategies for founding entrepreneurs and high-net-worth lineages seeking to institutionalize their legacy with absolute precision.',
  },
  {
    title: 'Clients Requiring Coordinated Private Advisory',
    copy: 'Sophisticated orchestration for clients with global footprints requiring seamless coordination across multi-jurisdictional private advisory ecosystems.',
  },
];

const services = [
  {
    title: 'Private Advisory',
    copy: 'Acting as your primary fiduciary and family office coordinator to oversee governance, tax efficiency, and global reporting.',
  },
  {
    title: 'Asset Management',
    copy: 'Exclusive access to institutional-grade investment vehicles and custom-tailored portfolios designed for absolute risk management.',
  },
  {
    title: 'Legacy Planning',
    copy: "Architecting multi-generational wealth transfer strategies that preserve both your capital and your family's core values long-term.",
  },
];
---

<BaseLayout>
  <Header />
  <main id="home">
    <section class="relative isolate min-h-[100svh] overflow-hidden bg-ink text-white">
      <video
        class="absolute inset-0 size-full object-cover opacity-[0.56]"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={stockImg.src}
        aria-label="Wealth Advisor"
      >
        <source src={heroVideo} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(17,21,28,0.9),rgba(17,21,28,0.58)_48%,rgba(17,21,28,0.22))]"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>

      <div class="relative mx-auto flex min-h-[100svh] max-w-7xl flex-col justify-end px-5 pb-14 pt-36 lg:px-8 lg:pb-18">
        <div
          class="relative isolate max-w-4xl"
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <div class="absolute inset-x-[-2rem] bottom-[-2.5rem] top-[-3rem] -z-10 bg-[radial-gradient(ellipse_at_center,rgba(17,21,28,0.72),rgba(17,21,28,0.36)_48%,transparent_72%)] blur-xl"></div>
          <div
            class="hero-emblem-start mb-7 w-44 sm:w-60 lg:w-72"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'hero-emblem-in' : 'hero-emblem-start'"
          >
            <Image
              src={emblem}
              alt="Varsity Wealth emblem"
              widths={[220, 360, 520]}
              sizes="(min-width: 1024px) 360px, 220px"
              priority
              class="h-auto w-full"
            />
          </div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-[0.28em] text-brass">Independent Fee-Only Wealth Management</p>
          <h1 class="hero-copy-shadow max-w-[12ch] font-serif uppercase text-5xl leading-[0.98] text-white sm:text-7xl lg:text-[6.7rem]">
            Raising the <span class="animated-text">standard.</span>
          </h1>
          <p class="hero-copy-shadow mt-7 max-w-2xl text-lg leading-8 text-white/86 sm:text-xl">
            Personalized wealth strategies aligned with your financial goals, built around fiduciary clarity, disciplined planning, and family-office-level coordination.
          </p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href="#connect" class="luxury-transition inline-flex min-h-12 items-center gap-2 bg-brass px-7 py-3 text-sm font-semibold uppercase tracking-[0.16em] text-ink hover:bg-white">
              Contact Us
              <ArrowRight class="size-4" />
            </a>
            <a href="#why-varsity" class="luxury-transition inline-flex min-h-12 items-center border border-white/32 px-7 py-3 text-sm font-semibold uppercase tracking-[0.16em] text-white bg-white/8 hover:border-brass hover:bg-white/9 hover:text-brass">
              Why Varsity Wealth
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="why-varsity" class="bg-ink px-5 pb-16 text-white lg:px-8 lg:pb-24">
      <div class="mx-auto grid max-w-7xl items-stretch gap-5 lg:grid-cols-3">
        {pillars.map(({ title, copy, icon: Icon }) => (
          <a
            href="#about"
            class="group luxury-card flex h-full flex-col bg-white/[0.055] p-7 shadow-panel backdrop-blur-sm hover:bg-white/[0.09] focus-visible:bg-white/[0.09] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brass/70 sm:p-8"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'reveal-in' : 'reveal-start'"
          >
            <Icon class="mb-8 size-9 text-brass" stroke-width={1.5} />
            <h2 class="max-w-xs font-serif text-3xl leading-[1.08] text-white">{title}</h2>
            <div class="my-6 h-px w-16 bg-brass/70"></div>
            <p class="text-base leading-7 text-white/68">{copy}</p>
                  <span class="mt-auto inline-flex w-fit items-center gap-2 pt-8 text-sm font-semibold uppercase tracking-[0.16em] text-white/76 learn-more-transition underline decoration-brass/70 underline-offset-8 group-hover:text-brass group-focus-visible:text-brass">
                    <span>Learn More</span>
                    <ArrowRight class="size-4 text-brass learn-more-transition group-hover:translate-x-1 group-focus-visible:translate-x-1" stroke-width={1.8} />
                  </span>
          </a>
        ))}
      </div>
    </section>

    <section
      id="about"
      class="bg-parchment bg-cover bg-center px-5 py-18 lg:px-8 lg:py-28"
      style={`background-image: linear-gradient(rgba(247, 244, 238, 0.54), rgba(247, 244, 238, 1)), url(${bg1.src});`}
    >
      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div
          class="relative"
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <Image
            src={stockImg2}
            alt="Architectural city skyline representing private wealth planning"
            widths={[520, 720, 960]}
            sizes="(min-width: 1024px) 44vw, 100vw"
            class="aspect-[4/5] w-full object-cover shadow-soft"
          />
          <div class="absolute -bottom-6 -right-4 bg-ink px-6 py-5 text-white shadow-panel sm:right-8">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brass">The Varsity Standard</p>
            <p class="mt-2 font-serif text-2xl">Precision with discretion</p>
          </div>
        </div>

        <div
          class="max-w-2xl lg:pl-6"
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <p class="section-kicker">Personalized Wealth Strategies</p>
          <h2 class="section-title">Aligned with your financial goals.</h2>
          <p class="mt-7 text-lg leading-8 text-ink">
            At the core of our approach is a commitment to developing thoughtful, personalized wealth strategies tailored to your unique goals, time horizon, and overall financial picture.
          </p>
          <p class="mt-5 text-lg leading-8 text-ink">
            We combine careful planning with time-tested principles to help you navigate each stage of your financial journey with clarity and confidence. Whether your focus is on growth, income, or long-term planning, our strategies are designed to keep you aligned with your objectives and moving forward with purpose.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-linear-to-b from-[rgba(247, 244, 238, 1)] to-mist px-5 py-18 lg:px-8 lg:py-26">
      <div class="mx-auto max-w-7xl">
        <div
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <p class="section-kicker">What We Do</p>
          <h2 class="section-title">A clearer standard for private wealth.</h2>
        </div>
        <div
          class="relative mt-10 shadow-panel"
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <div class="absolute left-1/2 top-1/2 z-10 hidden size-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-ink font-serif text-2xl text-brass shadow-[0_0_0_6px_#eef0ee,0_24px_80px_rgba(17,21,28,0.12)] md:grid">VS</div>
          <div class="grid md:grid-cols-2">
            <div class="bg-white/72 px-7 pb-5 pt-8 sm:px-10">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-graphite/55">The Industry</p>
              <h3 class="mt-2 font-serif text-4xl leading-tight text-graphite">Traditional Model</h3>
            </div>
            <div class="bg-ink px-7 pb-5 pt-8 text-white sm:px-10">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brass">Our Commitment</p>
              <h3 class="mt-2 font-serif text-4xl leading-tight text-white">The Varsity Standard</h3>
            </div>
          </div>
          {traditional.map((item, index) => (
            <div class="grid md:grid-cols-2">
              <div class="flex gap-4 border-t border-ink/12 bg-white/72 px-7 py-5 text-base leading-7 text-graphite/72 sm:px-10 md:pr-14">
                <span class="mt-3 h-px w-7 shrink-0 bg-graphite/35"></span>
                <span>{item}</span>
              </div>
              <div class="flex gap-4 border-t border-white/12 bg-ink px-7 py-5 text-base leading-7 text-white/82 sm:px-10 md:pl-14">
                <CircleCheck class="mt-1 size-5 shrink-0 text-brass" stroke-width={1.8} />
                <span>{varsity[index]}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-parchment px-0 py-18 lg:py-0">
      <div class="grid min-h-[42rem] lg:min-h-[48rem] lg:grid-cols-[0.9fr_1.1fr]">
        <div
          class="relative min-h-[24rem] overflow-hidden shadow-soft lg:min-h-full"
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <Image
            src={stockImg3}
            alt="Refined city skyline representing complex private wealth"
            widths={[900, 1200, 1600]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="absolute inset-0 size-full object-cover"
          />
        </div>

        <div class="flex items-center bg-parchment px-5 py-16 lg:px-16 xl:px-24">
          <div
            class="w-full"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'reveal-in' : 'reveal-start'"
          >
            <p class="section-kicker">Who We Serve</p>
            <h2 class="section-title">Focused on Legacy & Stewardship</h2>
            <div class="mt-10 grid gap-6">
              {audiences.map(({ title, copy }, index) => (
                <a
                  href="#connect"
                  class="group luxury-card flex h-full flex-col bg-white p-8 shadow-soft hover:shadow-panel sm:p-10"
                  x-data="{ shown: false }"
                  x-intersect.once="shown = true"
                  :class="shown ? 'reveal-in' : 'reveal-start'"
                  style={`transition-delay: ${index * 120}ms`}
                >
                  <h3 class="font-serif text-3xl text-ink mb-4">{title}</h3>
                  <p class="text-base leading-7 text-graphite/80">{copy}</p>
                  <span class="mt-auto inline-flex w-fit items-center gap-2 pt-8 text-sm font-semibold uppercase tracking-[0.16em] text-graphite/76 learn-more-transition underline decoration-brass/70 underline-offset-8 group-hover:text-brass group-focus-visible:text-brass">
                    <span>Learn More</span>
                    <ArrowRight class="size-4 text-brass learn-more-transition group-hover:translate-x-1 group-focus-visible:translate-x-1" stroke-width={1.8} />
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="process" class="bg-ink px-5 py-18 text-white lg:px-8 lg:py-28">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p class="section-kicker text-brass">An Elite Approach to Wealth Stewardship</p>
          <h2 class="font-serif text-4xl leading-[1.08] text-white sm:text-6xl lg:leading-[65px]">Institutional discipline, private-office attention.</h2>
        </div>

        <div class="mt-12 grid border-t border-white/12 lg:grid-cols-3">
          {services.map(({ title, copy }, index) => (
            <article
              class="border-white/12 py-10 lg:border-l lg:px-10 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0"
              x-data="{ shown: false }"
              x-intersect.once="shown = true"
              :class="shown ? 'reveal-in' : 'reveal-start'"
              style={`transition-delay: ${index * 120}ms`}
            >
              <p class="font-serif text-lg italic tracking-[0.08em] text-brass">{['I.', 'II.', 'III.'][index]}</p>
              <h3 class="mt-4 font-serif text-3xl text-white">{title}</h3>
              <div class="my-6 h-px w-16 bg-brass/70"></div>
              <p class="max-w-sm text-base leading-7 text-white/68">{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-parchment px-5 py-18 lg:px-8 lg:py-28">
      <div class="mx-auto max-w-7xl">
        <div
          x-data="{ shown: false }"
          x-intersect.once="shown = true"
          :class="shown ? 'reveal-in' : 'reveal-start'"
        >
          <p class="section-kicker">The Varsity Standard</p>
          <h2 class="section-title">Wealth is more than a metric<br>it is a <em class="text-brass">narrative of achievement.</em></h2>
          <div class="mt-6 h-0.5 w-20 bg-brass"></div>
        </div>

        <div class="mt-12 grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-stretch">
          <div
            class="relative h-full"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'reveal-in' : 'reveal-start'"
          >
            <Image
              src={stockImg6}
              alt="Refined city architecture symbolizing legacy wealth stewardship"
              widths={[520, 720, 960]}
              sizes="(min-width: 1024px) 34vw, 100vw"
              class="h-full min-h-[28rem] w-full object-cover shadow-soft"
            />
            <div class="absolute left-6 bottom-6 inline-flex items-center gap-4 bg-ink/90 px-4 py-3 text-white shadow-panel backdrop-blur-sm">
              <ShieldCheck class="size-8 shrink-0 text-brass" stroke-width={1.3} />
              <div>
                <p class="text-xs font-semibold uppercase text-white/78">Capital is the foundation<br>Legacy is the masterwork.</p>
              </div>
            </div>
          </div>

          <div
            class="flex h-full flex-col"
            x-data="{ shown: false }"
            x-intersect.once="shown = true"
            :class="shown ? 'reveal-in' : 'reveal-start'"
          >
            <article class="luxury-card flex h-full flex-col bg-white p-8 shadow-soft hover:shadow-panel sm:p-10">
              <p class="section-kicker">The Sentinel of Your Private Legacy</p>
              <h2 class="font-serif text-4xl leading-[1.08] text-ink">Comprehensive advisory for multi-generational families.</h2>
              <p class="mt-7 text-lg leading-8 text-ink">
                We serve as the primary architect for your family's financial future, balancing institutional-grade discipline with the bespoke attention of a private family office.
              </p>
              <p class="mt-5 text-lg leading-8 text-ink">
                Varsity Wealth provides comprehensive advisory services for multi-generational families who require an elite level of stewardship. As a private financial planning boutique, we act as your dedicated family office, orchestrating complex portfolios with absolute precision and uncompromised discretion.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
